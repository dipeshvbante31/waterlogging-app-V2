# Copy to .env and edit. Load it with:  python -m uvicorn main:app --env-file .env
# Nothing here is a secret by default: the app needs no API keys. Never commit a real .env.

WW_ENV=development                 # "production" hides /docs and /openapi.json
WW_LOG_LEVEL=INFO

# Prediction history. SQLite for local use; PostgreSQL for production (install requirements-prod.txt).
# Do not use SQLite on hosts with an ephemeral filesystem: history would vanish on every restart.
WW_DATABASE_URL=sqlite:///./data/waterlogging.db
# WW_DATABASE_URL=postgresql://user:password@host:5432/waterlogging
WW_SAVE_HISTORY=true

# Where model.joblib / metadata / metrics live (deployment setting; never taken from a request)
WW_MODELS_DIR=models

# Weather provider behaviour
WW_HTTP_TIMEOUT_S=10
WW_WEATHER_CACHE_TTL_S=600         # reuse a response for this long and label it "cached"
WW_WEATHER_STALE_TTL_S=10800       # if the provider is down, show data up to this old, labelled "stale"

# Abuse protection (per client address, per process; 0 disables)
WW_RATE_LIMIT_PER_MINUTE=30
WW_MAX_BODY_BYTES=16384
